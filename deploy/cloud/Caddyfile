{
    cert_issuer acme {
        dir https://acme-v02.api.letsencrypt.org/directory
    }
}
{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 129MiB
    }
    reverse_proxy api:8080 {
        header_down Content-Security-Policy "connect-src 'self';" "connect-src 'self' https://api.github.com;"
    }
}
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
